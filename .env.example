# Copia este archivo a .env y ajusta los valores. `scripts/db.sh init` lo rellena por ti.

# PostgreSQL (cluster local del proyecto, puerto 5433)
APUESTAS_DATABASE_URL=postgresql+psycopg://apuestas:CAMBIAR@127.0.0.1:5433/apuestas

# Zona horaria para horarios de tareas y mensajes
APUESTAS_TIMEZONE=America/Lima

# --- Opcionales -------------------------------------------------------------
# OddsPapi (cuenta gratuita en https://oddspapi.io): cuotas de Betano. Elige Betano como casa de tu suscripción
APUESTAS_ODDSPAPI_KEY=
# Casas a descargar (cada una = 1 petición al día; el plan gratuito da 250 al mes)
APUESTAS_ODDSPAPI_BOOKMAKERS=betano.pe,pinnacle

# Bot de Telegram (créalo con @BotFather) y tu chat_id para alertas
APUESTAS_TELEGRAM_TOKEN=
APUESTAS_TELEGRAM_CHAT_ID=

# Usuario por defecto para el servidor MCP local (stdio)
APUESTAS_DEFAULT_USER=renzo

# Entrenar también con las ligas extra de football-data (Austria, Noruega, Suiza...). Ver docs/modelos.md
# APUESTAS_EXTRA_LEAGUES_IN_MODEL=false

# Capturas de cuotas (panel → Capturas). Motor: claude_code (tu suscripción, por defecto), api (de pago) o none
# APUESTAS_CAPTURES_ENGINE=claude_code
# Usuarios cuyas capturas procesa el motor automático (vacío = solo APUESTAS_DEFAULT_USER)
# APUESTAS_CAPTURES_ENGINE_USERS=
# Modelo del CLI de Claude Code para leer capturas (alias: sonnet, opus, haiku)
# APUESTAS_CAPTURES_CLI_MODEL=sonnet
# Solo para el motor api: clave de la API de Claude
# APUESTAS_ANTHROPIC_API_KEY=
