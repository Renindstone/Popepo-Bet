# Copia este archivo a .env.local si necesitas cambiar algo.
# Dirección de la API FastAPI (.venv/bin/apuestas api)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Clave de la API: solo hace falta si abres el panel desde otra máquina.
# También se puede escribir en el panel (Estado de los datos → Conexión).
# NEXT_PUBLIC_API_KEY=apk_...
